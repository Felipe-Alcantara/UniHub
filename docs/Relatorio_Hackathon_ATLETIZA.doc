<style>
  :root {
    --ink: #14181f;
    --muted: #5b6472;
    --brand: #0f3d2e;
    --accent: #16a34a;
    --line: #e3e7ec;
    --soft: #f5f7f9;
  }
  * { box-sizing: border-box; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body {
    font-family: "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
    color: var(--ink);
    line-height: 1.6;
    margin: 0;
    font-size: 15px;
  }
  .page { max-width: 820px; margin: 0 auto; padding: 0 48px 48px; }

  /* ===== Capa ===== */
  .cover {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    background: linear-gradient(160deg, #0f3d2e 0%, #0b2a20 100%);
    color: #fff;
    padding: 60px;
    page-break-after: always;
  }
  .cover .logo { width: 360px; max-width: 70%; margin-bottom: 28px; }
  .cover h1 {
    font-size: 40px; letter-spacing: 6px; margin: 0 0 6px;
    font-weight: 800;
  }
  .cover .sub { font-size: 19px; opacity: .92; margin: 0 0 40px; font-weight: 300; }
  .cover .divider { width: 80px; height: 3px; background: var(--accent); border: none; margin: 0 0 40px; border-radius: 2px; }
  .cover .meta { font-size: 15px; opacity: .9; line-height: 1.9; }
  .cover .meta b { font-weight: 700; }
  .cover .repo { margin-top: 28px; font-size: 13px; opacity: .8; word-break: break-all; }

  /* ===== Conteúdo ===== */
  h2 {
    color: var(--brand);
    font-size: 22px;
    margin: 38px 0 4px;
    padding-top: 14px;
    border-top: 2px solid var(--line);
  }
  h2:first-of-type { border-top: none; }
  h2 .pts {
    font-size: 13px; color: #fff; background: var(--accent);
    padding: 2px 10px; border-radius: 20px; vertical-align: middle;
    margin-left: 8px; font-weight: 600;
  }
  h3 { color: var(--ink); font-size: 16px; margin: 22px 0 6px; }
  p { margin: 8px 0; }
  strong { color: var(--ink); }
  a { color: var(--accent); }

  table {
    width: 100%; border-collapse: collapse; margin: 14px 0;
    font-size: 14px; page-break-inside: avoid;
  }
  th, td { text-align: left; padding: 9px 12px; border: 1px solid var(--line); vertical-align: top; }
  th { background: var(--brand); color: #fff; font-weight: 600; }
  tr:nth-child(even) td { background: var(--soft); }

  ul { margin: 8px 0; padding-left: 22px; }
  li { margin: 4px 0; }

  blockquote {
    margin: 14px 0; padding: 12px 16px;
    background: var(--soft); border-left: 4px solid var(--accent);
    color: var(--muted); border-radius: 0 6px 6px 0;
  }
  blockquote ul { margin: 6px 0; }

  .note { font-size: 13px; color: var(--muted); }
  .footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line);
    text-align: center; color: var(--muted); font-size: 13px; }

  /* ===== Galeria de prints ===== */
  .shots { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 16px 0; }
  .shot { page-break-inside: avoid; }
  .shot img {
    width: 100%; height: auto; display: block;
    border: 1px solid var(--line); border-radius: 8px;
    box-shadow: 0 4px 14px rgba(0,0,0,0.10);
  }
  .shot .cap { font-size: 13px; color: var(--muted); margin-top: 6px; text-align: center; }
  .shot .cap b { color: var(--brand); }
  .shot.wide { grid-column: 1 / -1; }

  @media print {
    .cover { min-height: 0; height: 100vh; }
    h2 { page-break-after: avoid; }
    table, blockquote { page-break-inside: avoid; }
  }
</style>

